# Que el código viaje igual entre Windows, macOS y Linux: en el repositorio
# siempre con saltos de línea LF, y en cada equipo como toque.
* text=auto eol=lf

# Binarios: que git no intente convertir nada.
*.png binary
*.jpg binary
*.ico binary
*.mp4 binary
*.mp3 binary

# Los .cmd de Windows, con saltos de línea de Windows: con LF, cmd.exe puede
# leer mal los bloques y las etiquetas en otro equipo.
*.cmd text eol=crlf
